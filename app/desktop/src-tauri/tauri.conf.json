{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Listency",
  "version": "0.5.0",
  "identifier": "com.voiceagent.local",
  "build": {
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Listency",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "externalBin": ["binaries/listency-backend"],
    "resources": ["binaries/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNzY4NzFCMEEyQkMyQUEKUldTcXdpc0tHNGQyWGwrTmRmMXRUMjZpYVlBcllsdjVxOXRvSXFVQ1FYWThwcVd3c08rWUkvc0MK",
      "endpoints": [
        "https://github.com/Talen-520/Listency/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
